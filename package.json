{
  "name": "polis-css-metropolis",
  "version": "1.0.0",
  "private": true,
  "description": "A living 3D city built with nothing but HTML and CSS.",
  "license": "MIT",
  "author": "TIENDUNG21",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node tools/build.js",
    "check:dist": "node tools/check-dist.js dist",
    "lint": "npm run lint:css && npm run lint:js",
    "lint:css": "stylelint \"scss/**/*.scss\"",
    "lint:js": "eslint .",
    "lint:html": "html-validate dist/index.html",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \"tests/unit/*.test.js\"",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build && npm run check:dist && npm run lint:html",
    "test:e2e": "node tools/build.js && playwright test",
    "serve": "node tools/serve.js --port 5180",
    "screenshots": "node tools/screenshots.js",
    "stats": "node tools/stats.js",
    "measure": "node tools/measure.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "html-validate": "^11.4.0",
    "sass": "^1.108.2",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "^7.0.2"
  }
}
